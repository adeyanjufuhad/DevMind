# DevMind Environment Variables

# Primary Model: Google Gemini 1.5 Flash (Free tier via Google AI Studio)
# Required for Stages 3, 4, and 5 (Fixer, Tester, Documenter)
GEMINI_API_KEY=your_gemini_api_key_here

# Required for Stages 1 and 2 (CodeBERT, StarCoder2)
# Free tier Hugging Face User Access Token (read)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Optional: Claude API key (if using fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server configuration
HOST=0.0.0.0
PORT=8000
